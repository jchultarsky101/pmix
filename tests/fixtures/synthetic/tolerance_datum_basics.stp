ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('pmix synthetic fixture: geometric tolerance and datum basics'),'2;1');
FILE_NAME('tolerance_datum_basics.stp','2026-09-06T00:00:00',('pmix'),('pmix'),'pmix synthetic','pmix','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 3 1 4 }'));
ENDSEC;
DATA;
/* units */
#1=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#2=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#3=(CONVERSION_BASED_UNIT('DEGREE',#4) NAMED_UNIT(#5) PLANE_ANGLE_UNIT());
#4=PLANE_ANGLE_MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(0.0174532925),#2);
#5=DIMENSIONAL_EXPONENTS(0.,0.,0.,0.,0.,0.,0.);
#6=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#3)) REPRESENTATION_CONTEXT('','3D'));
/* product skeleton */
#10=PRODUCT('SYN-002','pmix synthetic part','',(#11));
#11=PRODUCT_CONTEXT('',#12,'mechanical');
#12=APPLICATION_CONTEXT('managed model based 3d engineering');
#13=PRODUCT_DEFINITION_FORMATION('','',#10);
#14=PRODUCT_DEFINITION('design','',#13,#15);
#15=PRODUCT_DEFINITION_CONTEXT('part definition',#12,'design');
#16=PRODUCT_DEFINITION_SHAPE('','',#14);
/* geometry: a base plane, a side plane, a hole, a boss face */
#20=CARTESIAN_POINT('',(0.,0.,0.));
#21=DIRECTION('',(0.,0.,1.));
#22=DIRECTION('',(1.,0.,0.));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
#25=ADVANCED_FACE('base',(),#24,.T.);
#26=DIRECTION('',(0.,1.,0.));
#27=AXIS2_PLACEMENT_3D('',#20,#22,#26);
#28=PLANE('',#27);
#29=ADVANCED_FACE('side',(),#28,.T.);
#30=CYLINDRICAL_SURFACE('',#23,5.);
#31=ADVANCED_FACE('hole',(),#30,.T.);
#32=CARTESIAN_POINT('',(30.,0.,0.));
#33=AXIS2_PLACEMENT_3D('',#32,#21,#22);
#34=PLANE('',#33);
#35=ADVANCED_FACE('boss',(),#34,.T.);
#36=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#25,#29,#31,#35),#6);
#37=SHAPE_DEFINITION_REPRESENTATION(#16,#36);
/* datum A on the base plane, with a point target A1 */
#40=DATUM_FEATURE('Datum Feature A','',#16,.T.);
#41=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#40,#36,#25);
#42=DATUM('','',#16,.F.,'A');
#43=SHAPE_ASPECT_RELATIONSHIP('','',#40,#42);
#44=PLACED_DATUM_TARGET_FEATURE('Datum Target A1','point',#16,.T.,'1');
#45=SHAPE_ASPECT_RELATIONSHIP('','',#44,#42);
#46=FEATURE_FOR_DATUM_TARGET_RELATIONSHIP('','',#40,#44);
#47=PROPERTY_DEFINITION('','',#44);
#48=CARTESIAN_POINT('',(10.,10.,0.));
#49=AXIS2_PLACEMENT_3D('orientation',#48,#21,#22);
#50=(LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(2.),#1) REPRESENTATION_ITEM('target diameter'));
#51=SHAPE_REPRESENTATION_WITH_PARAMETERS('',(#49,#50),#6);
#52=SHAPE_DEFINITION_REPRESENTATION(#47,#51);
/* datum B on the side plane, datum C on the hole */
#60=DATUM_FEATURE('Datum Feature B','',#16,.T.);
#61=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#60,#36,#29);
#62=DATUM('','',#16,.F.,'B');
#63=SHAPE_ASPECT_RELATIONSHIP('','',#60,#62);
#64=DATUM_FEATURE('Datum Feature C','',#16,.T.);
#65=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#64,#36,#31);
#66=DATUM('','',#16,.F.,'C');
#67=SHAPE_ASPECT_RELATIONSHIP('','',#64,#66);
/* datum system A|B(M)|C */
#70=DATUM_REFERENCE_COMPARTMENT('','',#16,.F.,#42,$);
#71=DATUM_REFERENCE_COMPARTMENT('','',#16,.F.,#62,(SIMPLE_DATUM_REFERENCE_MODIFIER(.MAXIMUM_MATERIAL_REQUIREMENT.)));
#72=DATUM_REFERENCE_COMPARTMENT('','',#16,.F.,#66,$);
#73=DATUM_SYSTEM('DRF 1','',#16,.F.,(#70,#71,#72));
/* datum system with common datum A-B */
#74=DATUM_REFERENCE_ELEMENT('','',#16,.F.,#42,$);
#75=DATUM_REFERENCE_ELEMENT('','',#16,.F.,#62,$);
#76=DATUM_REFERENCE_COMPARTMENT('','',#16,.F.,COMMON_DATUM_LIST((#74,#75)),$);
#77=DATUM_SYSTEM('DRF 2','',#16,.F.,(#76));
/* 1: position diameter 0.1 MMC projected 10 to A|B(M)|C on the hole, composite with a lower segment 0.05 */
#80=SHAPE_ASPECT('hole','',#16,.T.);
#81=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#80,#36,#31);
#82=(LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(0.1),#1) QUALIFIED_REPRESENTATION_ITEM((#83)) REPRESENTATION_ITEM(''));
#83=VALUE_FORMAT_TYPE_QUALIFIER('NR2 1.2');
#84=(GEOMETRIC_TOLERANCE('Position.1','',#82,#80) GEOMETRIC_TOLERANCE_WITH_DATUM_REFERENCE((#73)) GEOMETRIC_TOLERANCE_WITH_MODIFIERS((.MAXIMUM_MATERIAL_REQUIREMENT.)) POSITION_TOLERANCE());
#85=TOLERANCE_ZONE_FORM('cylindrical or circular');
#86=TOLERANCE_ZONE('','',#16,.F.,(#84),#85);
#87=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(10.),#1);
#88=PROJECTED_ZONE_DEFINITION(#86,(),#40,#87);
#89=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#1);
#90=(GEOMETRIC_TOLERANCE('Position.1 lower','',#89,#80) GEOMETRIC_TOLERANCE_WITH_DATUM_REFERENCE((#73)) POSITION_TOLERANCE());
#91=TOLERANCE_ZONE('','',#16,.F.,(#90),#85);
#92=GEOMETRIC_TOLERANCE_RELATIONSHIP('composite','',#84,#90);
/* 2: flatness 0.02 per 25 x 25 unit area on the base, simple instance form */
#100=SHAPE_ASPECT('base','',#16,.T.);
#101=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#100,#36,#25);
#102=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.02),#1);
#103=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.),#1);
#104=(FLATNESS_TOLERANCE() GEOMETRIC_TOLERANCE('Flatness.1','',#102,#100) GEOMETRIC_TOLERANCE_WITH_DEFINED_AREA_UNIT(.SQUARE.,$) GEOMETRIC_TOLERANCE_WITH_DEFINED_UNIT(#103));
/* 3: perpendicularity 0.05 to A on the side, simple instance with datum set */
#110=SHAPE_ASPECT('side','',#16,.T.);
#111=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#110,#36,#29);
#112=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#1);
#113=DATUM_REFERENCE_COMPARTMENT('','',#16,.F.,#42,$);
#114=DATUM_SYSTEM('DRF 3','',#16,.F.,(#113));
#115=PERPENDICULARITY_TOLERANCE('Perpendicularity.1','',#112,#110,(#114));
#116=TOLERANCE_ZONE_FORM('between two equidistant surfaces');
#117=TOLERANCE_ZONE('','',#16,.F.,(#115),#116);
/* 4: surface profile 0.4 unequally disposed 0.1, free state, to A-B on the boss */
#120=SHAPE_ASPECT('boss','',#16,.T.);
#121=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#120,#36,#35);
#122=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.4),#1);
#123=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.1),#1);
#124=(GEOMETRIC_TOLERANCE('Profile.1','',#122,#120) GEOMETRIC_TOLERANCE_WITH_DATUM_REFERENCE((#77)) GEOMETRIC_TOLERANCE_WITH_MODIFIERS((.FREE_STATE.)) SURFACE_PROFILE_TOLERANCE() UNEQUALLY_DISPOSED_GEOMETRIC_TOLERANCE(#123));
/* 5: circular runout 0.03 with a 30 degree runout zone to C */
#130=DATUM_REFERENCE_COMPARTMENT('','',#16,.F.,#66,$);
#131=DATUM_SYSTEM('DRF 4','',#16,.F.,(#130));
#132=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.03),#1);
#133=CIRCULAR_RUNOUT_TOLERANCE('Runout.1','',#132,#120,(#131));
#134=TOLERANCE_ZONE_FORM('cylindrical or circular');
#135=TOLERANCE_ZONE('','',#16,.F.,(#133),#134);
#136=(MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(30.),#3) PLANE_ANGLE_MEASURE_WITH_UNIT() REPRESENTATION_ITEM(''));
#137=RUNOUT_ZONE_ORIENTATION(#136);
#138=RUNOUT_ZONE_DEFINITION(#135,(),#137);
ENDSEC;
END-ISO-10303-21;
