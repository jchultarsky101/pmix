ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('pmix synthetic fixture: presentation basics'),'2;1');
FILE_NAME('presentation_basics.stp','2026-09-06T00:00:00',('pmix'),('pmix'),'pmix synthetic','pmix','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 3 1 4 }'));
ENDSEC;
DATA;
/* units and context with an uncertainty of 0.001 */
#1=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#2=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#3=(CONVERSION_BASED_UNIT('DEGREE',#4) NAMED_UNIT(#5) PLANE_ANGLE_UNIT());
#4=PLANE_ANGLE_MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(0.0174532925),#2);
#5=DIMENSIONAL_EXPONENTS(0.,0.,0.,0.,0.,0.,0.);
#6=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#7)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#3)) REPRESENTATION_CONTEXT('','3D'));
#7=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#1,'distance_accuracy_value','');
/* product skeleton */
#10=PRODUCT('SYN-003','pmix synthetic part','',(#11));
#11=PRODUCT_CONTEXT('',#12,'mechanical');
#12=APPLICATION_CONTEXT('managed model based 3d engineering');
#13=PRODUCT_DEFINITION_FORMATION('','',#10);
#14=PRODUCT_DEFINITION('design','',#13,#15);
#15=PRODUCT_DEFINITION_CONTEXT('part definition',#12,'design');
#16=PRODUCT_DEFINITION_SHAPE('','',#14);
/* geometry: a base plane and a hole */
#20=CARTESIAN_POINT('',(0.,0.,0.));
#21=DIRECTION('',(0.,0.,1.));
#22=DIRECTION('',(1.,0.,0.));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
#25=ADVANCED_FACE('base',(),#24,.T.);
#26=CYLINDRICAL_SURFACE('',#23,5.);
#27=ADVANCED_FACE('hole',(),#26,.T.);
#28=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#25,#27),#6);
#29=SHAPE_DEFINITION_REPRESENTATION(#16,#28);
/* semantic: datum A on the base, position tolerance 0.1 on the hole to A, diameter 10 +/-0.05 */
#40=DATUM_FEATURE('Datum Feature A','',#16,.T.);
#41=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#40,#28,#25);
#42=DATUM('','',#16,.F.,'A');
#43=SHAPE_ASPECT_RELATIONSHIP('','',#40,#42);
#44=DATUM_REFERENCE_COMPARTMENT('','',#16,.F.,#42,$);
#45=DATUM_SYSTEM('DRF','',#16,.F.,(#44));
#50=SHAPE_ASPECT('hole','',#16,.T.);
#51=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#50,#28,#27);
#52=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.1),#1);
#53=(GEOMETRIC_TOLERANCE('Position.1','',#52,#50) GEOMETRIC_TOLERANCE_WITH_DATUM_REFERENCE((#45)) POSITION_TOLERANCE());
#54=TOLERANCE_ZONE_FORM('cylindrical or circular');
#55=TOLERANCE_ZONE('','',#16,.F.,(#53),#54);
#60=DIMENSIONAL_SIZE(#50,'diameter');
#61=(LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(10.),#1) REPRESENTATION_ITEM('nominal value'));
#62=SHAPE_DIMENSION_REPRESENTATION('',(#61),#6);
#63=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#60,#62);
#64=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(-0.05),#1);
#65=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#1);
#66=TOLERANCE_VALUE(#64,#65);
#67=PLUS_MINUS_TOLERANCE(#66,#60);
/* explicit text on the dimension through a pmi validation property */
#70=PROPERTY_DEFINITION('pmi validation property','',#60);
#71=DESCRIPTIVE_REPRESENTATION_ITEM('equivalent unicode string','DIM\\w\X2\2300\X0\10 \X2\00B1\X0\0.05');
#72=REPRESENTATION('',(#71),#6);
#73=PROPERTY_DEFINITION_REPRESENTATION(#70,#72);
/* styling */
#80=COLOUR_RGB('',1.,0.,0.);
#81=DRAUGHTING_PRE_DEFINED_CURVE_FONT('continuous');
#82=CURVE_STYLE('',#81,POSITIVE_LENGTH_MEASURE(0.2),#80);
#83=PRESENTATION_STYLE_ASSIGNMENT((#82));
/* callout 1: tessellated position frame, complex-instance form, linked to the tolerance */
#90=CARTESIAN_POINT('',(20.,20.,0.));
#91=AXIS2_PLACEMENT_3D('',#90,#21,#22);
#92=COORDINATES_LIST('',4,((0.,0.,0.),(4.,0.,0.),(4.,2.,0.),(0.,2.,0.)));
#93=TESSELLATED_CURVE_SET('',#92,((1,2,3,4,1)));
#94=COORDINATES_LIST('',3,((1.,1.,0.),(2.,1.,0.),(1.5,1.8,0.)));
#95=COMPLEX_TRIANGULATED_SURFACE_SET('',#94,$,3,(),((1,2,3)));
#96=(GEOMETRIC_REPRESENTATION_ITEM() REPOSITIONED_TESSELLATED_ITEM(#91) REPRESENTATION_ITEM('position') TESSELLATED_GEOMETRIC_SET((#93,#95)) TESSELLATED_ITEM());
#97=TESSELLATED_ANNOTATION_OCCURRENCE('Position.1',(#83),#96);
#98=DRAUGHTING_CALLOUT('Position.1',(#97));
#99=ANNOTATION_PLANE('',(#83),#91,(#98));
#100=DRAUGHTING_MODEL_ITEM_ASSOCIATION('PMI representation to presentation link','',#53,#200,#98);
#101=DRAUGHTING_MODEL_ITEM_ASSOCIATION('','',#50,#200,#98);
#102=PRESENTATION_LAYER_ASSIGNMENT('PMI','PMI layer',(#97));
/* callout 2: placeholder with leader line for datum A, plus a related callout with a polyline part */
#110=CARTESIAN_POINT('',(5.,-10.,0.));
#111=AXIS2_PLACEMENT_3D('Position',#110,#21,#22);
#112=PLANAR_BOX('',6.,3.,#111);
#113=GEOMETRIC_SET('datum',(#111,#112));
#114=APLL_POINT('Leader Point',(8.,-8.5,0.),.NONE.);
#115=APLL_POINT('Leader Point',(8.,0.,0.),.INTERNAL_PAIR_FORWARD_ARROWHEAD.);
#116=ANNOTATION_TO_MODEL_LEADER_LINE('',(#114,#115));
#117=ANNOTATION_PLACEHOLDER_OCCURRENCE_WITH_LEADER_LINE('Datum A',(#83),#113,.GPS_DATA.,3.,(#116));
#118=DRAUGHTING_CALLOUT('Datum A',(#117));
#119=CARTESIAN_POINT('',(5.,-10.,0.));
#120=CARTESIAN_POINT('',(11.,-10.,0.));
#121=POLYLINE('',(#119,#120));
#122=GEOMETRIC_CURVE_SET('datum',(#121));
#123=ANNOTATION_CURVE_OCCURRENCE('Datum A frame',(#83),#122);
#124=DRAUGHTING_CALLOUT('Datum A frame',(#123));
#125=DRAUGHTING_CALLOUT_RELATIONSHIP('','',#118,#124);
#126=ANNOTATION_PLANE('',(#83),#111,(#118,#124));
#127=DRAUGHTING_MODEL_ITEM_ASSOCIATION_WITH_PLACEHOLDER('PMI representation to presentation link','',#40,#200,#118,#117);
/* callout 3: diameter dimension with explicit text, linked to the dimension */
#130=CARTESIAN_POINT('',(0.,30.,0.));
#131=AXIS2_PLACEMENT_3D('',#130,#21,#22);
#132=COORDINATES_LIST('',2,((0.,30.,0.),(10.,30.,0.)));
#133=TESSELLATED_CURVE_SET('',#132,((1,2)));
#134=TESSELLATED_GEOMETRIC_SET('diameter dimension',(#133));
#135=TESSELLATED_ANNOTATION_OCCURRENCE('Diameter.1',(#83),#134);
#136=DRAUGHTING_CALLOUT('Diameter.1',(#135));
#137=ANNOTATION_PLANE('',(#83),#131,(#136));
#138=DRAUGHTING_MODEL_ITEM_ASSOCIATION('PMI representation to presentation link','',#60,#200,#136);
/* standalone supplemental geometry: an axis line outside any callout */
#140=CARTESIAN_POINT('',(0.,0.,-20.));
#141=CARTESIAN_POINT('',(0.,0.,20.));
#142=POLYLINE('',(#140,#141));
#143=GEOMETRIC_CURVE_SET('Axis',(#142));
#144=ANNOTATION_CURVE_OCCURRENCE('Axis',(#83),#143);
/* global draughting model */
#200=(CHARACTERIZED_OBJECT(*,*) CHARACTERIZED_REPRESENTATION() DRAUGHTING_MODEL() REPRESENTATION('',(#99,#126,#137,#144),#6));
/* saved view MBD_A showing callouts 1 and 2; default view showing everything */
#210=CARTESIAN_POINT('',(0.,0.,100.));
#211=AXIS2_PLACEMENT_3D('View Reference',#210,#21,#22);
#212=CARTESIAN_POINT('',(0.,0.,0.));
#213=PLANAR_BOX('',200.,150.,#211);
#214=VIEW_VOLUME(.PARALLEL.,#212,100.,0.,.F.,0.,.F.,.F.,#213);
#215=CAMERA_MODEL_D3('MBD_A',#211,#214);
#216=(CHARACTERIZED_OBJECT(*,*) CHARACTERIZED_REPRESENTATION() DRAUGHTING_MODEL() REPRESENTATION('MBD_A',(#215,#99,#126),#6));
#217=MODEL_GEOMETRIC_VIEW('MBD_A','',#215,#216);
#220=CARTESIAN_POINT('',(100.,100.,100.));
#221=DIRECTION('',(0.577,0.577,0.577));
#222=DIRECTION('',(-0.707,0.707,0.));
#223=AXIS2_PLACEMENT_3D('View Reference',#220,#221,#222);
#224=VIEW_VOLUME(.PARALLEL.,#212,173.2,0.,.F.,0.,.F.,.F.,#213);
#225=CAMERA_MODEL_D3('Isometric',#223,#224);
#226=REPRESENTATION_MAP(#23,#200);
#227=MAPPED_ITEM('',#226,#23);
#228=(CHARACTERIZED_OBJECT(*,*) CHARACTERIZED_REPRESENTATION() DRAUGHTING_MODEL() REPRESENTATION('Isometric',(#225,#227),#6));
#229=DEFAULT_MODEL_GEOMETRIC_VIEW('Isometric','',#225,#228,'','',#16,*);
ENDSEC;
END-ISO-10303-21;
