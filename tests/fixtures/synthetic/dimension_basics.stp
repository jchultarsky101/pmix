ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('pmix synthetic fixture: dimension basics'),'2;1');
FILE_NAME('dimension_basics.stp','2026-09-06T00:00:00',('pmix'),('pmix'),'pmix synthetic','pmix','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 3 1 4 }'));
ENDSEC;
DATA;
/* units: millimetres and degrees */
#1=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#2=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#3=(CONVERSION_BASED_UNIT('DEGREE',#4) NAMED_UNIT(#5) PLANE_ANGLE_UNIT());
#4=PLANE_ANGLE_MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(0.0174532925),#2);
#5=DIMENSIONAL_EXPONENTS(0.,0.,0.,0.,0.,0.,0.);
#6=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#3)) REPRESENTATION_CONTEXT('','3D'));
/* product skeleton */
#10=PRODUCT('SYN-001','pmix synthetic part','',(#11));
#11=PRODUCT_CONTEXT('',#12,'mechanical');
#12=APPLICATION_CONTEXT('managed model based 3d engineering');
#13=PRODUCT_DEFINITION_FORMATION('','',#10);
#14=PRODUCT_DEFINITION('design','',#13,#15);
#15=PRODUCT_DEFINITION_CONTEXT('part definition',#12,'design');
#16=PRODUCT_DEFINITION_SHAPE('','',#14);
/* geometry: one cylindrical face and two planar faces (bounds omitted) */
#20=CYLINDRICAL_SURFACE('',#21,6.25);
#21=AXIS2_PLACEMENT_3D('',#22,#23,#24);
#22=CARTESIAN_POINT('',(0.,0.,0.));
#23=DIRECTION('',(0.,0.,1.));
#24=DIRECTION('',(1.,0.,0.));
#25=ADVANCED_FACE('hole',(),#20,.T.);
#26=PLANE('',#21);
#27=ADVANCED_FACE('left',(),#26,.T.);
#28=PLANE('',#29);
#29=AXIS2_PLACEMENT_3D('',#30,#23,#24);
#30=CARTESIAN_POINT('',(40.,0.,0.));
#31=ADVANCED_FACE('right',(),#28,.T.);
#32=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#25,#27,#31),#6);
#33=SHAPE_DEFINITION_REPRESENTATION(#16,#32);
/* 1: diameter 12.50 +/-0.05 on the hole */
#40=SHAPE_ASPECT('hole','',#16,.T.);
#41=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#40,#32,#25);
#42=DIMENSIONAL_SIZE(#40,'diameter');
#43=(LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(12.5),#1) QUALIFIED_REPRESENTATION_ITEM((#44)) REPRESENTATION_ITEM('nominal value'));
#44=VALUE_FORMAT_TYPE_QUALIFIER('NR2 2.2');
#45=SHAPE_DIMENSION_REPRESENTATION('',(#43),#6);
#46=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#42,#45);
#47=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(-0.05),#1);
#48=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#1);
#49=TOLERANCE_VALUE(#47,#48);
#50=PLUS_MINUS_TOLERANCE(#49,#42);
/* 2: basic linear distance 40 between the two planar faces */
#60=SHAPE_ASPECT('left','',#16,.T.);
#61=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#60,#32,#27);
#62=SHAPE_ASPECT('right','',#16,.T.);
#63=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#62,#32,#31);
#64=DIMENSIONAL_LOCATION('linear distance',$,#60,#62);
#65=(LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(40.),#1) REPRESENTATION_ITEM('nominal value'));
#66=DESCRIPTIVE_REPRESENTATION_ITEM('dimensional note','theoretical');
#67=SHAPE_DIMENSION_REPRESENTATION('',(#65,#66),#6);
#68=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#64,#67);
/* 3: radius given as limits 6.2 .. 6.3 on a composite (pattern) feature */
#70=COMPOSITE_SHAPE_ASPECT('pattern','',#16,.F.);
#71=SHAPE_ASPECT('hole 1','',#16,.T.);
#72=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#71,#32,#25);
#73=SHAPE_ASPECT_RELATIONSHIP('','',#70,#71);
#74=DIMENSIONAL_SIZE(#70,'radius');
#75=(LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(6.2),#1) REPRESENTATION_ITEM('lower limit'));
#76=(LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(6.3),#1) REPRESENTATION_ITEM('upper limit'));
#77=SHAPE_DIMENSION_REPRESENTATION('',(#75,#76),#6);
#78=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#74,#77);
/* 4: angular size 30 degrees on the left face */
#80=ANGULAR_SIZE(#60,'angle',.EQUAL.);
#81=(MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(30.),#3) PLANE_ANGLE_MEASURE_WITH_UNIT() REPRESENTATION_ITEM('nominal value'));
#82=SHAPE_DIMENSION_REPRESENTATION('',(#81),#6);
#83=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#80,#82);
/* 5: diameter 12.5 H7 (limits and fits) with a controlled-radius style modifier */
#90=DIMENSIONAL_SIZE(#40,'diameter');
#91=(LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(12.5),#1) REPRESENTATION_ITEM('nominal value'));
#92=DESCRIPTIVE_REPRESENTATION_ITEM('','statistical');
#93=COMPOUND_REPRESENTATION_ITEM('modifiers',(#92));
#94=SHAPE_DIMENSION_REPRESENTATION('',(#91,#93),#6);
#95=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#90,#94);
#96=LIMITS_AND_FITS('H','','7','');
#97=PLUS_MINUS_TOLERANCE(#96,#90);
ENDSEC;
END-ISO-10303-21;
