ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('pmix synthetic fixture: property basics'),'2;1');
FILE_NAME('property_basics.stp','2026-09-07T00:00:00',('pmix'),('pmix'),'pmix synthetic','pmix','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 3 1 4 }'));
ENDSEC;
DATA;
/* units: millimetres, plus derived square and cubic millimetres */
#1=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#2=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#3=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#2)) REPRESENTATION_CONTEXT('','3D'));
#4=DERIVED_UNIT_ELEMENT(#1,2.);
#5=DERIVED_UNIT((#4));
#6=DERIVED_UNIT_ELEMENT(#1,3.);
#7=DERIVED_UNIT((#6));
/* product skeleton */
#10=PRODUCT('SYN-004','pmix synthetic part','',(#11));
#11=PRODUCT_CONTEXT('',#12,'mechanical');
#12=APPLICATION_CONTEXT('managed model based 3d engineering');
#13=PRODUCT_DEFINITION_FORMATION('','',#10);
#14=PRODUCT_DEFINITION('design','',#13,#15);
#15=PRODUCT_DEFINITION_CONTEXT('part definition',#12,'design');
#16=PRODUCT_DEFINITION_SHAPE('','',#14);
/* geometry: one planar face */
#20=CARTESIAN_POINT('',(0.,0.,0.));
#21=DIRECTION('',(0.,0.,1.));
#22=DIRECTION('',(1.,0.,0.));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=PLANE('',#23);
#25=ADVANCED_FACE('base',(),#24,.T.);
#26=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#25),#3);
#27=SHAPE_DEFINITION_REPRESENTATION(#16,#26);
/* one flatness tolerance, so a property can attach to a PMI record */
#30=SHAPE_ASPECT('base','',#16,.T.);
#31=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#30,#26,#25);
#32=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#1);
#33=FLATNESS_TOLERANCE('Flatness.1','',#32,#30);
/* product-level properties, one per value type */
#40=PROPERTY_DEFINITION('PLM__Part_Number','',#14);
#41=DESCRIPTIVE_REPRESENTATION_ITEM('Part_Number','SYN-004-REV-A');
#42=REPRESENTATION('Part_Number',(#41),#3);
#43=PROPERTY_DEFINITION_REPRESENTATION(#40,#42);
#44=PROPERTY_DEFINITION('PLM__Batch_Size','',#14);
#45=INTEGER_REPRESENTATION_ITEM('Batch_Size',250.);
#46=REPRESENTATION('Batch_Size',(#45),#3);
#47=PROPERTY_DEFINITION_REPRESENTATION(#44,#46);
#48=PROPERTY_DEFINITION('PLM__Unit_Price','',#14);
#49=REAL_REPRESENTATION_ITEM('Unit_Price',18.75);
#50=REPRESENTATION('Unit_Price',(#49),#3);
#51=PROPERTY_DEFINITION_REPRESENTATION(#48,#50);
#52=PROPERTY_DEFINITION('PLM__Release_Approved','',#14);
#53=BOOLEAN_REPRESENTATION_ITEM('Release_Approved',.T.);
#54=REPRESENTATION('Release_Approved',(#53),#3);
#55=PROPERTY_DEFINITION_REPRESENTATION(#52,#54);
/* geometric validation property: a volume in cubic millimetres */
#60=PROPERTY_DEFINITION('geometric validation property','',#14);
#61=MEASURE_REPRESENTATION_ITEM('volume measure',VOLUME_MEASURE(1234.5),#7);
#62=REPRESENTATION('',(#61),#3);
#63=PROPERTY_DEFINITION_REPRESENTATION(#60,#62);
/* pmi validation property attached to the tolerance: two values in one representation */
#70=PROPERTY_DEFINITION('pmi validation property','',#33);
#71=INTEGER_REPRESENTATION_ITEM('number of PMI presentation elements',1.);
#72=MEASURE_REPRESENTATION_ITEM('affected area',AREA_MEASURE(120.5),#5);
#73=REPRESENTATION('',(#71,#72),#3);
#74=PROPERTY_DEFINITION_REPRESENTATION(#70,#73);
ENDSEC;
END-ISO-10303-21;
